---
import BaseLayout from './BaseLayout.astro';
import Navbar from '@layouts/Navbar/Navbar.astro';
import CloudOverlay from '@components/ui/CloudOverlay/CloudOverlay.astro';
import { heroImages } from '@data/wedding';
---

<BaseLayout>
  <Fragment slot="head">
    <script is:inline>
      (function () {
        var access = localStorage.getItem('accessGranted');
        if (access !== 'full' && access !== 'limited') {
          window.location.replace('/');
        }
      })();
    </script>
    <link
      rel="preload"
      as="image"
      href={heroImages.mobile.src}
      media="(max-width: 767px)"
    />
    <link
      rel="preload"
      as="image"
      href={heroImages.desktop.src}
      media="(min-width: 768px)"
    />
  </Fragment>
  <CloudOverlay mode="exit" />
  <Navbar />
  <slot />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('cloud-overlay');
    if (overlay) {
      overlay.dataset.active = 'true';
    }
  });
</script>
