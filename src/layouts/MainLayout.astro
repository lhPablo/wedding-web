---
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Navbar from '@layouts/Navbar/Navbar.astro';
import CloudOverlay from '@components/ui/CloudOverlay/CloudOverlay.astro';
import { heroImages } from '@data/wedding';
import cloudSvg from '@assets/cloud.svg';

// Optimize images to WebP for preload
const optimizedMobile = await getImage({
  src: heroImages.mobile,
  format: 'webp',
  quality: 85,
});

const optimizedDesktop = await getImage({
  src: heroImages.desktop,
  format: 'webp',
  quality: 85,
});
---

<BaseLayout>
  <Fragment slot="head">
    <script>
      import { ACCESS_STORAGE_KEY, ACCESS_LEVELS } from '@lib/authConstants';

      (function () {
        var access = localStorage.getItem(ACCESS_STORAGE_KEY);
        if (access !== ACCESS_LEVELS.FULL && access !== ACCESS_LEVELS.LIMITED) {
          window.location.replace('/');
        }
      })();
    </script>
    <link rel="preload" as="image" href={cloudSvg.src} fetchpriority="high" />
    <link
      rel="preload"
      as="image"
      href={optimizedMobile.src}
      media="(max-width: 768px)"
      fetchpriority="high"
      type="image/webp"
    />
    <link
      rel="preload"
      as="image"
      href={optimizedDesktop.src}
      media="(min-width: 768px)"
      fetchpriority="high"
      type="image/webp"
    />
  </Fragment>
  <CloudOverlay mode="exit" />
  <Navbar />
  <slot />
</BaseLayout>
