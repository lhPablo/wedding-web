---
import AuthLayout from '@layouts/AuthLayout.astro';
import CheckIcon from '@components/ui/Icons/CheckIcon.astro';
import CrossIcon from '@components/ui/Icons/CrossIcon.astro';

import styles from './index.module.css';
---

<AuthLayout>
  <main>
    <div class={styles.loginContainer}>
      <div class={styles.loginCard}>
        <h1>Bienvenido</h1>
        <p class={styles.subtitle}>
          Introduce la clave de acceso para ver la invitación
        </p>

        <form id="login-form">
          <div class={styles.formGroup}>
            <label for="password">Clave de acceso</label>
            <input
              type="password"
              id="password"
              placeholder="Ingresa la clave de acceso"
              required
            />
          </div>

          <div class={styles.buttonWrapper}>
            <button id="submit" type="submit" class={styles.submitButton}>
              <span class={styles.buttonText}>Entrar</span>
              <span class={styles.checkIcon}>
                <CheckIcon />
              </span>
              <span class={styles.crossIcon}>
                <CrossIcon />
              </span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    import { initAuth } from './auth.ts';

    document.addEventListener('DOMContentLoaded', () => {
      initAuth();
    });
  </script>
</AuthLayout>
