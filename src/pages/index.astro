---
import AuthLayout from '@layouts/AuthLayout.astro';
import LoginForm from '@components/forms/LoginForm/LoginForm.astro';
---

<AuthLayout>
  <main class="login-container">
    <LoginForm />
  </main>
</AuthLayout>

<style>
  .login-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 2rem;
    position: relative;
    z-index: 10;
    overflow-y: auto;
  }

  @media (min-aspect-ratio: 1/1) and (max-height: 500px) {
    .login-container {
      padding: 1rem;
      align-items: flex-start;
    }
  }
</style>
