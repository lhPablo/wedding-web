---
import SubmitButton from '@components/ui/SubmitButton/SubmitButton.astro';
import logo from '@assets/logo.png';
import styles from './LoginForm.module.css';
---

<div class={styles['login-card']}>
  <div>
    <img src={logo.src} alt="Logo" class={styles['login-logo']} />
  </div>
  <h1>Bienvenido</h1>
  <p class={styles.subtitle}>
    Gracias por formar parte de un día tan especial, por favor introducid el
    código de embarque facilitado para acompañarnos en este viaje tan especial.
  </p>

  <form id="login-form">
    <div class={styles['form-group']}>
      <label for="password">Código de embarque</label>
      <input
        type="password"
        id="password"
        placeholder="Ingresa el código de embarque"
        required
      />
    </div>

    <div class={styles['button-wrapper']}>
      <SubmitButton id="submit" text="Entrar" />
    </div>
  </form>
</div>

<script>
  import { initAuth } from './loginHandler';

  document.addEventListener('DOMContentLoaded', () => {
    initAuth();
  });
</script>
