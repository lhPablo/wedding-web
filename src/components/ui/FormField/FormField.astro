---
import type { FormField } from '../../../types/form';
import styles from './FormField.module.css';

interface Props {
  field: FormField;
}

const { field } = Astro.props;
const { name, label, type, required, placeholder, options } = field;
---

<div class={styles.fieldGroup}>
  <label for={name} class={styles.label}>
    {label}
    {required && <span class={styles.required}>*</span>}
  </label>

  {
    type === 'textarea' ? (
      <textarea
        id={name}
        name={name}
        class={styles.textarea}
        required={required}
        placeholder={placeholder}
        rows={4}
      />
    ) : type === 'select' ? (
      <select id={name} name={name} class={styles.select} required={required}>
        <option value="">Selecciona una opción</option>
        {options?.map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
    ) : (
      <input
        id={name}
        name={name}
        type={type}
        class={styles.input}
        required={required}
        placeholder={placeholder}
        min={type === 'number' ? '0' : undefined}
      />
    )
  }
</div>
