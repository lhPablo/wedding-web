---
import cloudSvg from '@assets/cloud.svg';
import { generateClouds } from './cloudOverlay';

import styles from './CloudOverlay.module.css';

interface Props {
  mode: 'enter' | 'exit';
}

const { mode } = Astro.props;
const clouds = generateClouds(50);
---

<div id="cloud-overlay" class={styles['cloud-overlay']} data-mode={mode}>
  <div class={styles['fog-layer']}></div>

  {
    clouds.map((cloud) => (
      <img
        class={`${styles.cloud} ${styles[`cloud-${cloud.side}`]}`}
        src={cloudSvg.src}
        alt=""
        style={cloud.style}
      />
    ))
  }
</div>
