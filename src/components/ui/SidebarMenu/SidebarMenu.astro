---
import { sections } from '@data/sections';
import { sectionConfig } from '@lib/sectionConfig';

import styles from './SidebarMenu.module.css';
---

<div class={styles.hamburger} id="hamburger">
  <span></span>
  <span></span>
  <span></span>
</div>

<div class={styles.overlay} id="overlay"></div>

<nav class={styles.sidebar} id="sidebar">
  {
    sections.map(({ id, title }) => {
      const Icon = sectionConfig[id].Icon;

      return (
        <a href={`#${id}`} data-label={title}>
          <Icon />
          <span>{title}</span>
        </a>
      );
    })
  }
</nav>

<script>
  import { initSidebar } from './sidebar';
  initSidebar();
</script>
