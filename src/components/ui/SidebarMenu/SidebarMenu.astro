---
import { sections } from '@data/sections';
import { sectionConfig } from '@lib/sectionConfig';
import { MenuIconTypes } from 'src/types/menuIconTypes';

import HomeIcon from '@components/ui/Icons/HomeIcon.astro';
import GiftIcon from '@components/ui/Icons/GiftIcon.astro';
import ConfirmIcon from '@components/ui/Icons/ConfirmIcon.astro';
import LocationIcon from '@components/ui/Icons/LocationIcon.astro';
import TransportIcon from '@components/ui/Icons/TransportIcon.astro';
import QuestionIcon from '@components/ui/Icons/QuestionIcon.astro';
import PhoneIcon from '@components/ui/Icons/PhoneIcon.astro';

import styles from './SidebarMenu.module.css';

import type { MenuIconType } from 'src/types/menuIconTypes';

const iconMap: Record<MenuIconType, any> = {
  [MenuIconTypes.HOME]: HomeIcon,
  [MenuIconTypes.GIFT]: GiftIcon,
  [MenuIconTypes.CONFIRM]: ConfirmIcon,
  [MenuIconTypes.LOCATION]: LocationIcon,
  [MenuIconTypes.TRANSPORT]: TransportIcon,
  [MenuIconTypes.QUESTION]: QuestionIcon,
  [MenuIconTypes.PHONE]: PhoneIcon,
};
---

<div class={styles.hamburger} id="hamburger" data-active="false">
  <span></span>
  <span></span>
  <span></span>
</div>

<div class={styles.overlay} id="overlay" data-active="false"></div>

<nav class={styles.sidebar} id="sidebar" data-open="false">
  {
    sections.map(({ id, title }) => {
      const Icon = iconMap[sectionConfig[id].icon];

      return (
        <a href={`#${id}`} data-label={title}>
          <Icon />
          <span>{title}</span>
        </a>
      );
    })
  }
</nav>

<script>
  import { initSidebar } from './sidebar';
  initSidebar();
</script>
