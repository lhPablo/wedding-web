---
import type { FieldConfig } from '../../../types/field';
import { FieldTypes } from 'src/types/fieldTypes';

import styles from './Field.module.css';

interface Props {
  config: FieldConfig;
}

const { config } = Astro.props;
const { name, label, type, required, placeholder, options } = config;
---

<div class={styles['field-group']}>
  <label for={name} class={styles.label}>
    {label}
    {required && <span class={styles.required}>*</span>}
  </label>

  {
    type === FieldTypes.TEXTAREA ? (
      <textarea
        id={name}
        name={name}
        class={styles.textarea}
        required={required}
        placeholder={placeholder}
        rows={4}
      />
    ) : type === FieldTypes.SELECT ? (
      <select id={name} name={name} class={styles.select} required={required}>
        <option value="">Selecciona una opción</option>
        {options?.map((option) => (
          <option value={option}>{option}</option>
        ))}
      </select>
    ) : (
      <input
        id={name}
        name={name}
        type={type}
        class={styles.input}
        required={required}
        placeholder={placeholder}
        min={type === FieldTypes.NUMBER ? '0' : undefined}
      />
    )
  }
</div>
