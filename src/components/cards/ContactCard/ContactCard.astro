---
import { Image } from 'astro:assets';
import WhatsAppIcon from '@components/ui/Icons/WhatsAppIcon.astro';

import styles from './ContactCard.module.css';

interface Props {
  name: string;
  email: string;
  phone?: string;
  avatar?: ImageMetadata;
  avatarAlt?: ImageMetadata;
  avatarMobile?: ImageMetadata;
  avatarAltMobile?: ImageMetadata;
  role?: string;
}

const {
  name,
  email,
  phone,
  avatar,
  avatarAlt,
  avatarMobile,
  avatarAltMobile,
  role,
} = Astro.props;

const whatsappNumber = phone?.replace(/[\s+]/g, '') || '';
const hasDesktopTransition = avatar && avatarAlt;
const hasMobileTransition = avatarMobile && avatarAltMobile;
const hasAnyAvatar = avatar || avatarMobile;
---

<div class={styles.container} data-contact-card>
  <div class={styles['contact-card']}>
    {
      hasAnyAvatar ? (
        <div class={styles['avatar-container']}>
          {hasDesktopTransition ? (
            <>
              <Image
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-desktop']} ${styles['avatar-default']}`}
                data-avatar-default
                format="webp"
                quality={85}
              />
              <Image
                src={avatarAlt}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-desktop']} ${styles['avatar-alt']}`}
                format="webp"
                quality={85}
              />
            </>
          ) : (
            avatar && (
              <Image
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-desktop']}`}
                format="webp"
                quality={85}
              />
            )
          )}

          {hasMobileTransition ? (
            <>
              <Image
                src={avatarMobile}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-default']}`}
                data-avatar-default
                format="webp"
                quality={85}
              />
              <Image
                src={avatarAltMobile}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-alt']}`}
                format="webp"
                quality={85}
              />
            </>
          ) : avatarMobile ? (
            <Image
              src={avatarMobile}
              alt={name}
              class={`${styles.avatar} ${styles['avatar-mobile']}`}
              format="webp"
              quality={85}
            />
          ) : hasDesktopTransition ? (
            <>
              <Image
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-default']}`}
                data-avatar-default
                format="webp"
                quality={85}
              />
              <Image
                src={avatarAlt}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-alt']}`}
                format="webp"
                quality={85}
              />
            </>
          ) : (
            avatar && (
              <Image
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']}`}
                format="webp"
                quality={85}
              />
            )
          )}
        </div>
      ) : (
        <div class={styles['avatar-placeholder']}>
          {name
            .split(' ')
            .map((n) => n[0])
            .join('')
            .substring(0, 2)}
        </div>
      )
    }

    <h3>{name}</h3>

    {role && <span class={styles.role}>{role}</span>}

    <div class={styles['contact-info']}>
      <p>
        <span class={styles.icon}>📧</span>
        <a href={`mailto:${email}`}>{email}</a>
      </p>
      {
        phone && (
          <p>
            <span class={styles.icon}>📞</span>
            <a href={`tel:${phone}`}>{phone}</a>
          </p>
        )
      }
    </div>

    {
      phone && (
        <a
          href={`https://wa.me/${whatsappNumber}`}
          target="_blank"
          class={`btn ${styles['whatsapp-btn']}`}
        >
          <WhatsAppIcon size="1.25rem" color="white" />
          <span>WhatsApp</span>
        </a>
      )
    }
  </div>
</div>

<script>
  import { initAvatarTransition } from './contactCardHandler';

  initAvatarTransition();
</script>
