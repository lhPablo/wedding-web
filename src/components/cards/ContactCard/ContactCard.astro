---
import WhatsAppIcon from '@components/ui/Icons/WhatsAppIcon.astro';

import styles from './ContactCard.module.css';

interface Props {
  name: string;
  email: string;
  phone: string;
  avatar?: string;
  avatarFocus?: string;
  avatarMobile?: string;
  avatarFocusMobile?: string;
  role?: string;
}

const {
  name,
  email,
  phone,
  avatar,
  avatarFocus,
  avatarMobile,
  avatarFocusMobile,
  role,
} = Astro.props;

const whatsappNumber = phone?.replace(/[\s+]/g, '') || '';
const hasDesktopTransition = avatar && avatarFocus;
const hasMobileTransition = avatarMobile && avatarFocusMobile;
const hasAnyAvatar = avatar || avatarMobile;
---

<div class={styles.container}>
  <div class={styles['contact-card']}>
    {
      hasAnyAvatar ? (
        <div class={styles['avatar-container']}>
          {hasDesktopTransition ? (
            <>
              <img
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-desktop']} ${styles['avatar-default']}`}
              />
              <img
                src={avatarFocus}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-desktop']} ${styles['avatar-focus']}`}
              />
            </>
          ) : (
            avatar && (
              <img
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-desktop']}`}
              />
            )
          )}

          {hasMobileTransition ? (
            <>
              <img
                src={avatarMobile}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-default']}`}
              />
              <img
                src={avatarFocusMobile}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-focus']}`}
              />
            </>
          ) : avatarMobile ? (
            <img
              src={avatarMobile}
              alt={name}
              class={`${styles.avatar} ${styles['avatar-mobile']}`}
            />
          ) : hasDesktopTransition ? (
            <>
              <img
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-default']}`}
              />
              <img
                src={avatarFocus}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']} ${styles['avatar-focus']}`}
              />
            </>
          ) : (
            avatar && (
              <img
                src={avatar}
                alt={name}
                class={`${styles.avatar} ${styles['avatar-mobile']}`}
              />
            )
          )}
        </div>
      ) : (
        <div class={styles['avatar-placeholder']}>
          {name
            .split(' ')
            .map((n) => n[0])
            .join('')
            .substring(0, 2)}
        </div>
      )
    }

    <h3>{name}</h3>

    {role && <span class={styles.role}>{role}</span>}

    <div class={styles['contact-info']}>
      <p>
        <span class={styles.icon}>📧</span>
        <a href={`mailto:${email}`}>{email}</a>
      </p>
      <p>
        <span class={styles.icon}>📞</span>
        <a href={`tel:${phone}`}>{phone}</a>
      </p>
    </div>

    <a
      href={`https://wa.me/${whatsappNumber}`}
      target="_blank"
      class={`btn ${styles['whatsapp-btn']}`}
    >
      <WhatsAppIcon size="1.25rem" color="white" />
      <span>WhatsApp</span>
    </a>
  </div>
</div>
