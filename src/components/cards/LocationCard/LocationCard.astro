---
import styles from './LocationCard.module.css';

interface Props {
  image: string;
  title: string;
  description: string;
  address: string;
  mapLink: string;
  time?: string;
  badge?: string;
}

const { image, title, description, address, mapLink, time, badge } =
  Astro.props;
---

<div class={styles.container}>
  <div class={styles['photo-container']}>
    <img src={image} alt="Wedding location" class={styles.photo} />

    <div class={styles.overlay}></div>

    {badge && <span class={styles.badge}>{badge}</span>}

    <div class={styles.content}>
      <div class={styles['title-row']}>
        <h3>{title}</h3>
      </div>

      {
        time && (
          <p class={styles.time}>
            <span class={styles['time-icon']}>🕐</span>
            {time}
          </p>
        )
      }

      <p>{description}</p>
      <p class={styles.address}>{address}</p>
      <a href={mapLink} target="_blank" class="btn"> Ver en Google Maps </a>
    </div>
  </div>
</div>
