---
import styles from './ExpandableCard.module.css';

const { title, answer } = Astro.props;
---

<div class={styles.card} data-card>
  <div class={styles.header} data-header>
    <h3 class={styles.title}>{title}</h3>

    <div
      class={styles.chevron}
      data-toggle
      data-open="false"
      aria-expanded="false"
      aria-label="Mostrar detalles"
    >
      <span></span>
      <span></span>
    </div>
  </div>

  <div class={styles.panel} data-panel data-open="false">
    <p>{answer}</p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('[data-card]');

    cards.forEach((card) => {
      const header = card.querySelector('[data-header]');
      const btn = header?.querySelector('[data-toggle]') as HTMLElement;
      const panel = card.querySelector('[data-panel]') as HTMLElement;

      header?.addEventListener('click', () => {
        const isOpen = panel?.getAttribute('data-open') === 'true';
        const newState = !isOpen;

        panel?.setAttribute('data-open', String(newState));
        btn?.setAttribute('data-open', String(newState));
        btn?.setAttribute('aria-expanded', String(newState));
      });
    });
  });
</script>
