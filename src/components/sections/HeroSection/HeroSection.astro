---
import { wedding } from '@data/wedding';

import styles from './HeroSection.module.css';

const { id } = Astro.props;
---

<section id={id} class={styles.section}>
  <img class={styles['hero-image']} src={wedding.image} alt="Our main image" />
  <div class={styles['hero-content']}>
    <h1>{wedding.title}</h1>
    <h3>{wedding.date} | Nuestra Boda</h3>
  </div>
</section>
