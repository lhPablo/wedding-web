---
import { wedding } from '@data/wedding';
import { timerMessages } from '@data/timer';

import Timer from '@components/ui/Timer/Timer.astro';
import CopyIcon from '@components/ui/Icons/CopyIcon.astro';
import CheckIcon from '@components/ui/Icons/CheckIcon.astro';
import CrossIcon from '@components/ui/Icons/CrossIcon.astro';

import styles from './GiftSection.module.css';

const { id } = Astro.props;

// Legal names, only rendered when the environment provides them
const beneficiaries = [
  import.meta.env.GROOM_FULL_NAME,
  import.meta.env.BRIDE_FULL_NAME,
].filter(Boolean);
---

<section id={id} class={styles.section}>
  <h2>Regalo</h2>

  <p>
    Lo más importante es tu presencia, pero si quieres hacernos un regalo,
    puedes hacerlo a través de este número de cuenta:
  </p>
  <div>
    <div class={styles.iban}>
      <p>{wedding.iban}</p>
      <button
        type="button"
        class={`${styles['copy-button']} button-transparent`}
        data-copy-iban={wedding.iban}
        aria-label="Copiar IBAN al portapapeles"
      >
        <span data-icon="copy" data-visible="true" class={styles.icon}>
          <CopyIcon />
        </span>
        <span data-icon="check" data-visible="false" class={styles.icon}>
          <CheckIcon />
        </span>
        <span data-icon="cross" data-visible="false" class={styles.icon}>
          <CrossIcon />
        </span>
      </button>
    </div>
    <p class={styles.note}>Concepto (sugerido): nombre y apellidos.</p>
    {
      beneficiaries.length > 0 && (
        <div class={styles.note}>
          <p>Beneficiario (indistinto):</p>
          <ul>
            {beneficiaries.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <p data-timer-message>{timerMessages.upcoming}</p>
  <div class={styles['timer-container']}>
    <Timer weddingDate={new Date(wedding.date).getTime()} />
  </div>
</section>

<script>
  import { initGiftSection } from './giftHandler';

  document.addEventListener('DOMContentLoaded', () => {
    initGiftSection();
  });
</script>
