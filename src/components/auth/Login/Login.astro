---
import SubmitButton from '@components/ui/SubmitButton/SubmitButton.astro';
import logo from '@assets/logo.png';
import styles from './Login.module.css';
---

<div class={styles['login-container']}>
  <div class={styles['login-card']}>
    <div>
      <img src={logo.src} alt="Logo" class={styles['login-logo']} />
    </div>
    <h1>Bienvenido</h1>
    <p class={styles.subtitle}>
      Introduce la clave de acceso para ver la invitación
    </p>

    <form id="login-form">
      <div class={styles['form-group']}>
        <label for="password">Clave de acceso</label>
        <input
          type="password"
          id="password"
          placeholder="Ingresa la clave de acceso"
          required
        />
      </div>

      <div class={styles['button-wrapper']}>
        <SubmitButton id="submit" text="Entrar" />
      </div>
    </form>
  </div>
</div>

<script>
  import { initAuth } from './loginHandler';

  document.addEventListener('DOMContentLoaded', () => {
    initAuth();
  });
</script>
